// 주식 모의투자 앱 - 데이터 모델
// DB: PostgreSQL (Neon). 상태값은 String + 주석으로 명시해 마이그레이션 부담을 줄였다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // 서버리스(Vercel)에서는 커넥션 풀러 주소를 쓴다
  url       = env("DATABASE_URL")
  // 마이그레이션은 풀러를 우회한 직접 연결이 필요하다
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  // 구글로 가입한 사용자는 비밀번호가 없다
  password  String?
  provider  String   @default("local") // local | google
  // 관리자가 비밀번호를 초기화하면 true. 새 비밀번호로 바꾸기 전까지 앱 사용을 막는다
  mustChangePassword Boolean @default(false)
  googleId  String?  @unique
  image     String?
  role      String   @default("USER") // USER | ADMIN
  cash      Float // 예수금 (KRW)
  seedCash  Float // 최초 시드머니 (수익률 계산 기준)
  createdAt DateTime @default(now())

  holdings    Holding[]
  orders      Order[]
  watchlist   Watchlist[]
  snapshots   Snapshot[]
  aiDiagnoses AiDiagnosis[]

  @@index([role])
}

model Holding {
  id       String @id @default(cuid())
  userId   String
  symbol   String // 예: 005930.KS, AAPL
  name     String
  market   String // KR | US
  quantity Float
  avgPrice Float // 평균 매입가 (KRW 환산 기준)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([userId])
}

model Order {
  id         String    @id @default(cuid())
  userId     String
  symbol     String
  name       String
  market     String // KR | US
  side       String // BUY | SELL
  type       String // MARKET | LIMIT
  quantity   Float
  limitPrice Float? // LIMIT일 때만
  status     String    @default("PENDING") // PENDING | FILLED | CANCELED
  filledPrice Float?   // 체결 단가 (KRW)
  fee        Float     @default(0) // 수수료
  tax        Float     @default(0) // 증권거래세 (매도만)
  amount     Float     @default(0) // 체결 총액 (수수료/세금 제외)
  realizedPnl Float?   // 매도 시 실현손익
  memo       String?
  createdAt  DateTime  @default(now())
  filledAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

model Watchlist {
  id     String @id @default(cuid())
  userId String
  symbol String
  name   String
  market String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
}

// 자산 추이 그래프용 일별 스냅샷
model Snapshot {
  id         String   @id @default(cuid())
  userId     String
  date       String // YYYY-MM-DD (KST)
  totalValue Float // 예수금 + 평가금액
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

// 시세 캐시 (외부 API 호출 절약)
model QuoteCache {
  symbol    String   @id
  name      String
  market    String
  currency  String
  price     Float
  prevClose Float
  updatedAt DateTime @updatedAt
}

// AI 투자 습관 진단 결과. 호출 비용이 드니 결과를 저장해 재조회에 재사용하고,
// 사용 횟수 제한 판정에도 쓴다.
model AiDiagnosis {
  id        String   @id @default(cuid())
  userId    String
  model     String // 실제로 응답한 모델 (fallback 시 달라질 수 있다)
  score     Int
  result    Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
