# ---------- 필수 ----------
# PostgreSQL 연결 주소 (Neon 무료 플랜 권장)
# Neon 대시보드 > Connection string > "Pooled connection" 값
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# 위와 같은 값에서 "-pooler" 만 뺀 직접 연결 주소 (마이그레이션용)
DIRECT_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# JWT 서명 키. 반드시 바꿀 것.  npm run setup 이 자동 생성해준다
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ---------- 선택 ----------
# 가입 초대코드. 비우면 누구나 가입 가능
INVITE_CODE="우리반2025"

# 시작 자금 (원)
SEED_CASH="10000000"

# 장 마감 시간에도 거래 허용 (교육용). true 권장
ALLOW_24H="true"

# 이 이메일로 가입하면 자동 관리자 (쉼표 구분)
ADMIN_EMAILS="teacher@example.com"

# 구글 로그인. 둘 다 채워야 활성화되고, 비우면 버튼 자체가 안 뜬다.
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID (웹 애플리케이션)
# 승인된 리디렉션 URI 에 아래 두 개를 등록할 것:
#   http://localhost:3000/api/auth/google/callback
#   https://<배포주소>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI 투자 진단. 비우면 AI 진단 화면에 "설정 안 됨" 안내만 뜬다.
# https://console.anthropic.com 에서 발급. 사용량만큼 과금되므로 1인당 하루 3회로 제한해 두었다.
ANTHROPIC_API_KEY=""
