# ---------- 필수 ----------
# SQLite 파일 경로 (배포 시 영구 볼륨 경로로 변경)
DATABASE_URL="file:./dev.db"

# JWT 서명 키. 반드시 바꿀 것.  생성: openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ---------- 선택 ----------
# 가입 초대코드. 비우면 누구나 가입 가능
INVITE_CODE="우리반2025"

# 시작 자금 (원)
SEED_CASH="10000000"

# 장 마감 시간에도 거래 허용 (교육용). true 권장
ALLOW_24H="true"

# 이 이메일로 가입하면 자동 관리자 (쉼표 구분)
ADMIN_EMAILS="teacher@example.com"
